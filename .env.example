# Token z https://account.mapbox.com/access-tokens/
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here

VITE_API_BASE_URL=/api

# OAuth — te same Client ID co w backendzie (publiczne)
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
# Musi być identyczny z OAUTH_CALLBACK_URL_GITHUB w backendzie
VITE_GITHUB_OAUTH_CALLBACK_URL=http://localhost:5173/auth/callback/github

# Google Sign-In (frontend): w Google Cloud Console → Credentials → OAuth 2.0 Client (Web)
# dodaj Authorized JavaScript origins, np.:
#   http://localhost:5173
#   http://127.0.0.1:5173
# (localhost i 127.0.0.1 to różne origins — dodaj ten, którego używasz w przeglądarce)
